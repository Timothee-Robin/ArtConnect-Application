<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.artconnect.ui.MainController">
    <MenuBar>
        <Menu text="File">
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About"/>
        </Menu>
    </MenuBar>

    <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 5 10 5 10; -fx-background-color: #e0e0e0;">
        <Label fx:id="userLabel" text="Not logged in" />
        <Button fx:id="loginButton" text="Login" onAction="#handleLogin" />
        <Button fx:id="registerButton" text="Register" onAction="#handleRegister" />
        <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" visible="false" managed="false" />
        <Button fx:id="refreshButton" text="Refresh Data" onAction="#handleRefresh" />
    </HBox>
    
    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Discover">
            <fx:include fx:id="discoverTab" source="DiscoverTab.fxml"/>
        </Tab>
        <Tab text="Artists">
            <fx:include fx:id="artistsTab" source="ArtistsTab.fxml"/>
        </Tab>
        <Tab text="Artworks">
            <fx:include fx:id="artworksTab" source="ArtworksTab.fxml"/>
        </Tab>
        <Tab text="Galleries">
            <fx:include fx:id="galleriesTab" source="GalleriesTab.fxml"/>
        </Tab>
        <Tab text="Exhibitions">
            <fx:include fx:id="exhibitionsTab" source="ExhibitionsTab.fxml"/>
        </Tab>
        <Tab text="Workshops">
            <fx:include fx:id="workshopsTab" source="WorkshopsTab.fxml"/>
        </Tab>
        <Tab text="Community">
            <fx:include fx:id="communityTab" source="CommunityTab.fxml"/>
        </Tab>
    </TabPane>
    
    <HBox alignment="CENTER_RIGHT" prefHeight="30.0" style="-fx-background-color: #f0f0f0;">
        <padding>
            <Insets right="10.0" left="10.0"/>
        </padding>
        <Label fx:id="statusLabel" text="ArtConnect Pro v1.0 | Mode: Loading..."/>
    </HBox>
</VBox>
